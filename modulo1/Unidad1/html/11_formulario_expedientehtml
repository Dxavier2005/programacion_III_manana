<!DOCTYPE html>

<html>
<head>
    <title>Programacion 3</title>
</head>
<body>
    <p>Ejemplo de formulario simple</p>
    <form action="procesar.php" method="post">
        <table border="0">
            <tr>
                <th>
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre"></th>
                <th>
                    <label for="email">Email:</label>       
                    <input type="email" id="email" name="email">
                </th>
            </tr>
            <tr>
                <th>
                    <label for="fecha">Fecha de Nacimiento:</label>
                    <input type="date" id="fecha" name="fecha">
                </th>
                <th>
                    <label for="color">Color Favorito:</label>       
                    <input type="color" id="color" name="color">
            </tr>   
            <tr>
                <th>
                    <label for="telefono">Telefono:</label>
                    <input type="tel" id="telefono" name="telefono">
                </th>
                <th>
                    <label for="numero">Numero Favorito:</label>       
                    <input type="number" id="numero" name="numero">
                </th>    




                <th>
                    <label for="fecha">Genero</label>
                    <input type="radio" id="m" name="genero" value="m"><label for="m">Masculino</label>
                    <input type="radio" id="f" name="genero" value="f"><label for="f">Femenino</label>

                </th>
                <th>
                    <label for="pais">Pais</label>       
                    <select id="pais" name="pais">
                        <option value="ec">ec</option>
                        <option value="col">col</option>
                        <option value="mx">mx</option>
                        <option value="ve">ve</option>
                    </select>
            </tr>





              <th>
                    <label for="comentarios">comentarios</label>
                    <input type="Textarea" id="comentarios" name="comentarios" rows="10"></textarea>
                </th>
                <th>
                    <input type="checkbox" id="f" name="acepto" required>
                    <label for="acepto">Acepto terminos y condiciones</label>

                </th>
                
            </tr>
        
        </table>



        <input type="submit" value="Enviar">
        <input type="reset" value="Limpiar">
</body>
</html>